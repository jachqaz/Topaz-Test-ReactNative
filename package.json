{
  "name": "topaz-reactnative",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "expo": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "nw:clean": "node -e \"const fs=require('fs');for(const d of ['node_modules/react-native-css-interop/.cache','node_modules/.cache']){fs.rmSync(d,{recursive:true,force:true})}console.log('NativeWind cache limpiado')\"",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8080 tcp:8080",
    "test": "jest",
    "test:ci": "jest --coverage --ci",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind|react-native-css-interop|@reduxjs/toolkit|react-redux|react-native-mmkv))"
    ],
    "moduleNameMapper": {
      "^@reduxjs/toolkit$": "<rootDir>/node_modules/@reduxjs/toolkit/dist/cjs/index.js",
      "^@reduxjs/toolkit/query/react$": "<rootDir>/node_modules/@reduxjs/toolkit/dist/query/react/cjs/index.js",
      "^@reduxjs/toolkit/query$": "<rootDir>/node_modules/@reduxjs/toolkit/dist/query/cjs/index.js"
    },
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "node",
        "default"
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/app/navigation/**",
      "!src/types/**"
    ]
  },
  "private": true
}
